# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C: identificadores sem acento, comentários com acento, sempre UTF-8
[*.{c,h}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.ps1]
indent_size = 4

# quebra de linha dupla no fim da linha tem significado em Markdown
[*.md]
trim_trailing_whitespace = false
